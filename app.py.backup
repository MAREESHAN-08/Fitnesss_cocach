            display_df.columns = ['Timestamp', 'Exercise', 'Total Reps', 'Correct', 'Faulty', 'Score', 'Verdict', 'Feedback / Notes']
            display_df['Verdict'] = display_df['Verdict'].apply(lambda x: '✅ Optimal' if x == 1 else '❌ Faulty')
