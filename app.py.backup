            "⚠️ Squat (Controlled Descent Form)": ("IMAGE DATASET/squat/squat_1000031.jpg", "squat"),
            "🤸 Plank (Neutral Spinal Line)": ("IMAGE DATASET/plank/plank_100001.jpg", "plank"),
            "💪 Push-up (Biomechanics Check)": ("IMAGE DATASET/push up/push up_1000021.jpg", "pushup"),
            "🏋️ Deadlift (Posterior Chain Hinge)": ("IMAGE DATASET/deadlift/deadlift_100001.jpg", "deadlift"),
        }

        with demo_col1:
            st.markdown('<div class="modern-card">', unsafe_allow_html=True)
            selected_sample = st.radio("Choose Viva Demo Sample:", list(sample_options.keys()))
            run_sample = st.button("⚡ Run Instant Biomechanical Evaluation", type="primary", use_container_width=True)
            
            st.markdown("---")
            st.markdown("#### 🔥 Active Calorie Burn Estimator (METs)")
            user_weight = st.number_input("User Body Weight (kg):", 40, 150, 70)
            workout_mins = st.slider("Workout Duration (minutes):", 5, 60, 20)
            
            met_values = {"squat": 5.0, "pushup": 8.0, "plank": 3.8, "deadlift": 6.0, "pullup": 8.0}
            active_met = met_values.get(sample_options[selected_sample][1], 5.0)
            cal_burned = round((active_met * 3.5 * user_weight / 200) * workout_mins, 1)
            
            st.info(f"🔥 **Estimated Energy Expenditure:** `{cal_burned} kcal` (MET Intensity: {active_met})")
            st.markdown('</div>', unsafe_allow_html=True)

        with demo_col2:
            img_rel_path, default_label = sample_options[selected_sample]
            if os.path.exists(img_rel_path):
                img_sample = Image.open(img_rel_path)
                image_np = np.array(img_sample)
                image_rgb = cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB)
                results = pose.process(image_rgb)

                if results.pose_landmarks:
                    landmarks_list = [[lm.x, lm.y, lm.z, getattr(lm, 'visibility', 1.0)] for lm in results.pose_landmarks.landmark]
                    pred, conf, prob_dict, feats_dict = run_ml_inference(landmarks_list)
                    status, risk, score, errors, joint_angles, faulty_joints, rx = evaluate_advanced_posture(landmarks_list, pred)
                    is_correct = (len(errors) == 0)

                    annotated = image_np.copy()
                    annotated = draw_biomechanical_hud(annotated, landmarks_list, pred, is_correct, score, joint_angles, faulty_joints)

                    col_v1, col_v2 = st.columns(2)
                    with col_v1:
                        st.markdown('<div class="video-viewport-card">', unsafe_allow_html=True)
                        st.image(annotated, channels="RGB", caption="Live Biomechanical Keypoints", use_container_width=True)
                        st.markdown('</div>', unsafe_allow_html=True)
                    with col_v2:
                        st.plotly_chart(create_biomechanical_radar_chart(joint_angles, score), use_container_width=True)

                    st.markdown(f"""
                    <div class="modern-card">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <span style="font-size:1.25rem; font-weight:800; color:#38bdf8;">Exercise: {pred.upper()}</span>
                                <span style="color:#94a3b8; font-size:0.9rem;"> ({conf:.1f}% Confidence)</span>
                            </div>
                            <span class="status-badge {'success' if is_correct else 'danger'}">{status}</span>
                        </div>
                        <div style="margin-top:10px; font-weight:600; color:{'#34d399' if is_correct else '#fb7185'};">
                            {risk}
                        </div>
                    </div>
                    """, unsafe_allow_html=True)

                    # 🎙️ Voice Coach — Viva Showcase audio
                    viva_vc_msg = get_voice_feedback(
                        exercise=pred,
                        is_correct=is_correct,
                        errors=errors,
                        score=score
                    )
                    maybe_speak(viva_vc_msg, force=True)

                    if feats_dict:
                        st.plotly_chart(create_xai_feature_importance_chart(feats_dict), use_container_width=True)

                    pdf_showcase_data = generate_clinical_pdf_report(
                        user_name=f"Viva Candidate ({st.session_state['user_name']})",
                        exercise_name=pred,
                        is_correct=is_correct,
                        score=score,
                        accuracy_rate=100.0 if is_correct else 0.0,
                        total_frames=1,
                        joint_angles=joint_angles,
                        errors=errors,
                        injury_risk=risk,
                        prescriptions=rx,
                        file_name=os.path.basename(img_rel_path)
