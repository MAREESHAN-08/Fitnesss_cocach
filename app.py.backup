                        <div><span style="font-size:1.8rem; font-weight:800; color:#34d399;">0</span><br><small>CORRECT ✅</small></div>
                        <div><span style="font-size:1.8rem; font-weight:800; color:#fb7185;">0</span><br><small>FAULTY ❌</small></div>
                    </div>
                </div>
                """, unsafe_allow_html=True)

            if start:
                cap = cv2.VideoCapture(0)
                cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
                cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

                col_live_feed, col_live_dash = st.columns([1.1, 1])
                with col_live_feed:
                    st.markdown('<div class="video-viewport-card">', unsafe_allow_html=True)
                    st_frame = st.empty()
                    st.markdown('</div>', unsafe_allow_html=True)

                with col_live_dash:
                    st_ex = st.empty()
                    m_c1, m_c2, m_c3 = st.columns(3)
                    with m_c1: st_rep_total = st.empty()
                    with m_c2: st_rep_correct = st.empty()
                    with m_c3: st_posture_score = st.empty()
                    st_alert = st.empty()
                    st_radar_live = st.empty()

                stage = "UP"
                total_reps = 0
                correct_reps = 0
                wrong_reps = 0
                rep_min_knee = 180.0
                rep_max_torso = 0.0
                rep_min_elbow = 180.0
                rep_max_hip_dev = 0.0
                fps = 12
                frames_to_capture = int(duration * fps)
                last_score = 85
                active_ex = target_exercise.lower()

                for i in range(frames_to_capture):
                    ret, frame = cap.read()
                    if not ret:
                        st.warning("Webcam feed unavailable.")
                        break

                    image_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                    results = pose.process(image_rgb)

                    if results.pose_landmarks:
                        landmarks_list = [[lm.x, lm.y, lm.z, getattr(lm, 'visibility', 1.0)] for lm in results.pose_landmarks.landmark]
                        pred, conf, prob_dict, _ = run_ml_inference(landmarks_list)
                        active_ex = pred if target_exercise == "Auto-Detect (ML)" else target_exercise.lower()
                        
                        status, risk, score, errors, joint_angles, faulty_joints, rx = evaluate_advanced_posture(landmarks_list, active_ex)
                        is_correct = (len(errors) == 0)
                        last_score = score

                        # Precision Repetition State Machine
                        if active_ex == 'squat':
                            knee_ang = joint_angles['avg_knee']
                            torso_ang = joint_angles['torso_inc']
                            
                            if knee_ang < 125:
                                stage = "DOWN"
                                rep_min_knee = min(rep_min_knee, knee_ang)
                                rep_max_torso = max(rep_max_torso, torso_ang)
                            elif knee_ang > 148:
                                if stage == "DOWN":
                                    total_reps += 1
                                    # Depth check: Must reach <= 105° and maintain torso <= 48°
                                    if rep_min_knee <= 105 and rep_max_torso <= 48.0:
                                        correct_reps += 1
                                    else:
                                        wrong_reps += 1
                                        if rep_min_knee > 105:
                                            maybe_speak("Correction: Squat deeper until parallel. Injury Warning: Protect knee joints from patellar strain.", force=True)
                                        elif rep_max_torso > 48.0:
                                            maybe_speak("Correction: Lift your chest upright. Injury Warning: Forward lean causes acute lumbar shear stress.", force=True)
                                        else:
                                            maybe_speak("Correction: Check your form. Injury Warning: Maintain safe joint biomechanics.", force=True)
                                    rep_min_knee = 180.0
                                    rep_max_torso = 0.0
                                stage = "UP"

                        elif active_ex == 'pushup':
                            elbow_ang = joint_angles['avg_elbow']
                            hip_dev_val = abs(joint_angles['hip_dev'])
                            
                            if elbow_ang < 125:
                                stage = "DOWN"
                                rep_min_elbow = min(rep_min_elbow, elbow_ang)
                                rep_max_hip_dev = max(rep_max_hip_dev, hip_dev_val)
                            elif elbow_ang > 148:
                                if stage == "DOWN":
                                    total_reps += 1
                                    if rep_min_elbow <= 102 and rep_max_hip_dev <= 0.06:
                                        correct_reps += 1
                                    else:
                                        wrong_reps += 1
                                        if rep_min_elbow > 102:
                                            maybe_speak("Correction: Lower your chest smoothly to 90 degrees. Injury Warning: Prevents shoulder ligament overload.", force=True)
                                        elif rep_max_hip_dev > 0.06:
                                            maybe_speak("Correction: Tighten your core and squeeze glutes. Injury Warning: Sagging hips causes lumbar disc compression.", force=True)
                                        else:
                                            maybe_speak("Correction: Align your spine and core.", force=True)
                                    rep_min_elbow = 180.0
                                    rep_max_hip_dev = 0.0
                                stage = "UP"

                        rep_stats = {'total': total_reps, 'correct': correct_reps, 'wrong': wrong_reps}
                        frame = draw_biomechanical_hud(frame, landmarks_list, active_ex, is_correct, score, joint_angles, faulty_joints, rep_stats)

                        st_ex.markdown(f"### 🤖 Identified: **{active_ex.upper()}** (`{conf:.1f}%`)")
                        st_rep_total.metric("Total Reps", f"{total_reps}", f"State: {stage}")
                        st_rep_correct.metric("Correct Reps", f"{correct_reps}", f"{wrong_reps} Faulty", delta_color="normal")
                        st_posture_score.metric("Posture Quality", f"{score}/100", f"{joint_angles['symmetry_score']}% Sym")

                        if not is_correct:
                            st_alert.error(f"❌ **Fault:** {errors[0]}")
                        else:
                            st_alert.success("✅ **Optimal Form:** Safe biomechanics maintained.")

                        # 🎙️ VOICE COACH — Real-time spoken feedback
                        vc_msg = get_voice_feedback(
                            exercise=active_ex,
                            is_correct=is_correct,
                            errors=errors,
                            score=score,
                            rep_count=total_reps,
                            stage=stage
                        )
                        maybe_speak(vc_msg)

                        st_radar_live.plotly_chart(create_biomechanical_radar_chart(joint_angles, score), use_container_width=True)

                    st_frame.image(frame, channels="BGR", use_container_width=True)

                cap.release()
                st.success("🎉 Live workout session completed!")
                
                # Automatically save session to SQLite database
                if total_reps > 0 or last_score > 0:
                    log_workout_session(
                        username=active_user_handle,
                        exercise_name=active_ex,
                        total_reps=total_reps,
                        correct_reps=correct_reps,
                        wrong_reps=wrong_reps,
                        form_score=last_score,
                        is_correct=(wrong_reps == 0 and total_reps > 0),
                        feedback=f"Live session: {correct_reps}/{total_reps} correct reps"
                    )
                    st.info("💾 Session successfully recorded to SQLite database (`fitness_database.db`)!")

        # 2. CAMERA SNAPSHOT
        elif option == '📷 Live Camera Snapshot':
            camera_photo = st.camera_input("Capture pose photo for instant biomechanical analysis")

            if camera_photo is not None:
                image = Image.open(camera_photo)
                image_np = np.array(image)
                image_rgb = cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB)
                results = pose.process(image_rgb)

                if results.pose_landmarks:
                    landmarks_list = [[lm.x, lm.y, lm.z, getattr(lm, 'visibility', 1.0)] for lm in results.pose_landmarks.landmark]
                    pred, conf, prob_dict, feats_dict = run_ml_inference(landmarks_list)
                    status, risk, score, errors, joint_angles, faulty_joints, rx = evaluate_advanced_posture(landmarks_list, pred)
                    is_correct = (len(errors) == 0)

                    annotated = image_np.copy()
                    annotated = draw_biomechanical_hud(annotated, landmarks_list, pred, is_correct, score, joint_angles, faulty_joints)

                    col1, col2 = st.columns([1.1, 1])
                    with col1:
                        st.markdown('<div class="video-viewport-card">', unsafe_allow_html=True)
                        st.image(annotated, channels="RGB", caption="Biomechanical Skeleton Tracking", use_container_width=True)
                        st.markdown('</div>', unsafe_allow_html=True)
                        st.plotly_chart(create_biomechanical_radar_chart(joint_angles, score), use_container_width=True)

                    # 🎙️ Voice Coach — Snapshot feedback
                    snap_vc_msg = get_voice_feedback(
                        exercise=pred, is_correct=is_correct,
                        errors=errors, score=score
                    )
                    maybe_speak(snap_vc_msg, force=True)

                    with col2:
                        st.markdown(f"""
                        <div class="modern-card">
                            <h3 style="color: #38bdf8; margin-top:0;">🤖 Biomechanical Clinical Analysis</h3>
                            <div style="font-size: 1.3rem; font-weight: 800;">Exercise: <span style="color:#c084fc;">{pred.upper()}</span> ({conf:.1f}% Confidence)</div>
                            <div style="font-size: 1.1rem; font-weight: 700; color: {'#34d399' if is_correct else '#fb7185'}; margin: 10px 0;">
                                Posture Quality Score: {score}/100 | Symmetry: {joint_angles['symmetry_score']}%
                            </div>
                            <div class="status-badge {'success' if is_correct else 'danger'}">{status}</div>
                            <div style="margin-top: 12px; font-weight: 600; color: {'#34d399' if is_correct else '#fb7185'};">{risk}</div>
                        </div>
                        """, unsafe_allow_html=True)

                        with st.expander("🩺 Physiotherapy & Corrective Prescription", expanded=True):
                            for p in rx:
                                st.write(f"• {p}")

                        if feats_dict:
                            st.plotly_chart(create_xai_feature_importance_chart(feats_dict), use_container_width=True)

                        # Save to database
                        log_workout_session(
                            username=active_user_handle,
                            exercise_name=pred,
                            total_reps=1,
                            correct_reps=1 if is_correct else 0,
                            wrong_reps=0 if is_correct else 1,
                            form_score=score,
                            is_correct=is_correct,
                            feedback=status
                        )

                        pdf_bytes = generate_clinical_pdf_report(
                            user_name=st.session_state['user_name'],
                            exercise_name=pred,
                            is_correct=is_correct,
                            score=score,
                            accuracy_rate=100.0 if is_correct else 0.0,
                            total_frames=1,
                            joint_angles=joint_angles,
                            errors=errors,
                            injury_risk=risk,
                            prescriptions=rx,
                            file_name="Camera_Snapshot.jpg"
                        )
                        st.download_button(
                            label="📄 Download Clinical Posture Audit Report (PDF)",
                            data=pdf_bytes,
                            file_name=f"PoseAI_Clinical_Report_{pred}.pdf",
                            mime="application/pdf",
                            use_container_width=True
                        )

        # 3. UPLOAD FILE (PRECISION REP-AWARE VIDEO ENGINE & ACCURATE FINAL RESULTS)
        else:
            uploaded_file = st.file_uploader("Upload Image or Video (.mp4 / .mov / .jpg / .png)", type=["mp4", "avi", "mov", "jpg", "png"])
            if uploaded_file is not None:
                if uploaded_file.type in ["image/jpeg", "image/png"]:
                    image = Image.open(uploaded_file)
                    image_np = np.array(image)
                    image_rgb = cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB)
                    results = pose.process(image_rgb)

                    if results.pose_landmarks:
                        landmarks_list = [[lm.x, lm.y, lm.z, getattr(lm, 'visibility', 1.0)] for lm in results.pose_landmarks.landmark]
                        pred, conf, prob_dict, feats_dict = run_ml_inference(landmarks_list)
                        status, risk, score, errors, joint_angles, faulty_joints, rx = evaluate_advanced_posture(landmarks_list, pred)
                        is_correct = (len(errors) == 0)

                        annotated = image_np.copy()
                        annotated = draw_biomechanical_hud(annotated, landmarks_list, pred, is_correct, score, joint_angles, faulty_joints)

                        col1, col2 = st.columns([1.1, 1])
                        with col1:
                            st.markdown('<div class="video-viewport-card">', unsafe_allow_html=True)
                            st.image(annotated, channels="RGB", caption="Detected Pose & Biomechanical HUD", use_container_width=True)
                            st.markdown('</div>', unsafe_allow_html=True)
                            st.plotly_chart(create_biomechanical_radar_chart(joint_angles, score), use_container_width=True)

                        # 🎙️ Voice Coach — Image upload feedback
                        img_vc_msg = get_voice_feedback(
                            exercise=pred, is_correct=is_correct,
                            errors=errors, score=score
                        )
                        maybe_speak(img_vc_msg, force=True)

                        with col2:
                            st.markdown(f"""
                            <div class="modern-card">
                                <h3 style="color: #38bdf8; margin-top:0;">🤖 Biomechanical Clinical Analysis</h3>
                                <div style="font-size: 1.3rem; font-weight: 800;">Exercise: <span style="color:#c084fc;">{pred.upper()}</span> ({conf:.1f}% Confidence)</div>
                                <div style="font-size: 1.1rem; font-weight: 700; color: {'#34d399' if is_correct else '#fb7185'}; margin: 10px 0;">
                                    Posture Quality Score: {score}/100 | Symmetry: {joint_angles['symmetry_score']}%
                                </div>
                                <div class="status-badge {'success' if is_correct else 'danger'}">{status}</div>
                                <div style="margin-top: 12px; font-weight: 600; color: {'#34d399' if is_correct else '#fb7185'};">{risk}</div>
                            </div>
                            """, unsafe_allow_html=True)

                            with st.expander("🩺 Physiotherapy & Corrective Prescription", expanded=True):
                                for p in rx:
                                    st.write(f"• {p}")

                            if feats_dict:
                                st.plotly_chart(create_xai_feature_importance_chart(feats_dict), use_container_width=True)

                            # Save to database
                            log_workout_session(
                                username=active_user_handle,
                                exercise_name=pred,
                                total_reps=1,
                                correct_reps=1 if is_correct else 0,
                                wrong_reps=0 if is_correct else 1,
                                form_score=score,
                                is_correct=is_correct,
                                feedback=status
                            )

                            pdf_bytes = generate_clinical_pdf_report(
                                user_name=st.session_state['user_name'],
                                exercise_name=pred,
                                is_correct=is_correct,
                                score=score,
                                accuracy_rate=100.0 if is_correct else 0.0,
                                total_frames=1,
                                joint_angles=joint_angles,
                                errors=errors,
                                injury_risk=risk,
                                prescriptions=rx,
                                file_name=uploaded_file.name
                            )
                            st.download_button(
                                label="📄 Download Clinical Posture Audit Report (PDF)",
                                data=pdf_bytes,
                                file_name=f"PoseAI_Clinical_Report_{pred}.pdf",
                                mime="application/pdf",
                                use_container_width=True
                            )
                    else:
                        st.warning("No human pose detected in the uploaded image. Please ensure full body is visible.")

                else:
                    # Video Processing Engine
                    tfile = tempfile.NamedTemporaryFile(delete=False)
                    tfile.write(uploaded_file.read())
                    cap = cv2.VideoCapture(tfile.name)

                    st.markdown("<br>", unsafe_allow_html=True)
                    st.info("⚡ Processing video frames through Biomechanical Kinematic Engine...")

                    col_vid_player, col_vid_hud = st.columns([1.1, 1])
                    with col_vid_player:
                        st.markdown('<div class="video-viewport-card">', unsafe_allow_html=True)
                        st_video_frame = st.empty()
                        st.markdown('</div>', unsafe_allow_html=True)
                    with col_vid_hud:
                        st_vid_ex = st.empty()
                        v_c1, v_c2 = st.columns(2)
                        with v_c1: st_vid_score = st.empty()
                        with v_c2: st_vid_sym = st.empty()
                        st_vid_alert = st.empty()
                        st_vid_prog = st.progress(0)

                    total_frames = 0
                    correct_frames_cnt = 0
                    faulty_frames_cnt = 0
                    scores_list = []
                    unique_errors = set()
                    pred_counts = {}

                    vid_total_reps = 0
                    vid_correct_reps = 0
                    vid_faulty_reps = 0
                    rep_stage = "UP"
                    cur_rep_min_knee = 180.0
                    cur_rep_max_torso = 0.0
                    cur_rep_min_elbow = 180.0
                    cur_rep_max_hip_dev = 0.0
                    
                    global_min_knee = 180.0
                    global_max_torso = 0.0
                    global_min_elbow = 180.0
                    global_max_hip_dev = 0.0
                    plank_sag_count = 0
                    deadlift_round_count = 0

                    last_angles = {}
                    last_rx = []
                    last_risk = ""
                    last_feats = {}

                    tot_vid_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 100

                    while cap.isOpened():
                        ret, frame = cap.read()
                        if not ret:
                            break

                        total_frames += 1
                        image_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                        results = pose.process(image_rgb)

                        if results.pose_landmarks:
                            landmarks_list = [[lm.x, lm.y, lm.z, getattr(lm, 'visibility', 1.0)] for lm in results.pose_landmarks.landmark]
                            pred, conf, prob_dict, feats_dict = run_ml_inference(landmarks_list)
                            status, risk, score, errors, joint_angles, faulty_joints, rx = evaluate_advanced_posture(landmarks_list, pred)
                            is_correct = (len(errors) == 0)

                            if is_correct:
                                correct_frames_cnt += 1
                            else:
                                faulty_frames_cnt += 1
                                for err in errors:
                                    unique_errors.add(err)

                            scores_list.append(score)
                            pred_counts[pred] = pred_counts.get(pred, 0) + 1
                            last_angles = joint_angles
                            last_rx = rx
                            last_risk = risk
                            last_feats = feats_dict

                            knee_ang = joint_angles['avg_knee']
                            torso_ang = joint_angles['torso_inc']
                            elbow_ang = joint_angles['avg_elbow']
                            hip_dev_val = abs(joint_angles['hip_dev'])
                            
                            global_min_knee = min(global_min_knee, knee_ang)
                            global_max_torso = max(global_max_torso, torso_ang)
                            global_min_elbow = min(global_min_elbow, elbow_ang)
                            global_max_hip_dev = max(global_max_hip_dev, hip_dev_val)

                            # Repetition State Machine across video
                            if pred == 'squat':
                                if knee_ang < 125:
                                    rep_stage = "DOWN"
                                    cur_rep_min_knee = min(cur_rep_min_knee, knee_ang)
                                    cur_rep_max_torso = max(cur_rep_max_torso, torso_ang)
                                elif knee_ang > 148:
                                    if rep_stage == "DOWN":
                                        vid_total_reps += 1
                                        if cur_rep_min_knee <= 105 and cur_rep_max_torso <= 48.0:
                                            vid_correct_reps += 1
                                        else:
                                            vid_faulty_reps += 1
                                            if cur_rep_min_knee > 105:
                                                unique_errors.add(f"Shallow Squat: Rep depth reached only {cur_rep_min_knee:.0f}° (Target parallel ~90°)")
                                                maybe_speak("Correction: Squat deeper to parallel. Injury Warning: Protect knee tendons.", force=True)
                                            if cur_rep_max_torso > 48.0:
                                                unique_errors.add(f"Torso Forward Collapse: Back tilted excessively forward to {cur_rep_max_torso:.0f}°")
                                                maybe_speak("Correction: Keep chest upright. Injury Warning: Forward lean causes acute lumbar shear stress.", force=True)
                                        cur_rep_min_knee = 180.0
                                        cur_rep_max_torso = 0.0
                                    rep_stage = "UP"

                            elif pred == 'pushup':
                                if elbow_ang < 125:
                                    rep_stage = "DOWN"
                                    cur_rep_min_elbow = min(cur_rep_min_elbow, elbow_ang)
                                    cur_rep_max_hip_dev = max(cur_rep_max_hip_dev, hip_dev_val)
                                elif elbow_ang > 148:
                                    if rep_stage == "DOWN":
                                        vid_total_reps += 1
                                        if cur_rep_min_elbow <= 102 and cur_rep_max_hip_dev <= 0.06:
                                            vid_correct_reps += 1
                                        else:
                                            vid_faulty_reps += 1
                                            if cur_rep_min_elbow > 102:
                                                unique_errors.add(f"Incomplete Push-up Depth: Chest lowered only to {cur_rep_min_elbow:.0f}° (Target ~90°)")
                                                maybe_speak("Correction: Lower your chest smoothly to 90 degrees. Injury Warning: Prevents anterior shoulder overload.", force=True)
                                            if cur_rep_max_hip_dev > 0.06:
                                                unique_errors.add("Sagging Hips / Core Disengaged during push-up")
                                                maybe_speak("Correction: Squeeze glutes and brace core. Injury Warning: Sagging hips causes lumbar disc compression.", force=True)
                                        cur_rep_min_elbow = 180.0
                                        cur_rep_max_hip_dev = 0.0
                                    rep_stage = "UP"

                            elif pred == 'plank':
                                if hip_dev_val > 0.055:
                                    plank_sag_count += 1
                                    unique_errors.add("Sagging Lower Back: Hips dropped below neutral horizontal line")

                            elif pred == 'deadlift':
                                if torso_ang > 65.0 and knee_ang > 145.0:
                                    deadlift_round_count += 1
                                    unique_errors.add("Rounded Spine / Stiff Leg: Back bending forward without knee flexion")

                            frame = draw_biomechanical_hud(frame, landmarks_list, pred, is_correct, score, joint_angles, faulty_joints)

                            st_vid_ex.markdown(f"### 🤖 Class: **{pred.upper()}** (`{conf:.1f}%`)")
                            st_vid_score.metric("Live Score", f"{score}/100", "Form Quality")
                            st_vid_sym.metric("Symmetry", f"{joint_angles['symmetry_score']}%", "Left vs Right")
                            
                            if not is_correct:
                                st_vid_alert.error(f"❌ {errors[0]}")
                            else:
                                st_vid_alert.success("✅ Optimal Form Maintained")

                            # 🎙️ Voice Coach — Frame-by-frame feedback during video playback
                            vid_vc_msg = get_voice_feedback(
                                exercise=pred,
                                is_correct=is_correct,
                                errors=errors,
                                score=score,
                                rep_count=vid_total_reps,
                                stage=rep_stage
                            )
                            maybe_speak(vid_vc_msg)

                        st_video_frame.image(frame, channels="BGR", use_container_width=True)
                        st_vid_prog.progress(min(1.0, total_frames / max(1, tot_vid_frames)))

                    cap.release()
                    try:
                        os.remove(tfile.name)
                    except Exception:
                        pass

                    # =========================================================
                    # 🏆 COMPREHENSIVE FINAL VIDEO EVALUATION
                    # =========================================================
                    st.markdown("<br>", unsafe_allow_html=True)
                    st.markdown("""
                    <div class="top-navbar-card" style="margin-top: 10px;">
                        <div class="navbar-title" style="font-size: 1.6rem;">🏆 Video Biomechanical Audit & Final Evaluation Report</div>
                        <div style="color: #94a3b8; font-size: 0.85rem;">Complete statistical summary across all analyzed video frames.</div>
                    </div>
                    """, unsafe_allow_html=True)

                    primary_exercise = max(pred_counts, key=pred_counts.get) if pred_counts else "Unknown"
                    avg_score = round(sum(scores_list) / len(scores_list), 1) if scores_list else 0
                    
                    is_overall_correct = True
                    final_faults = []
                    
                    if primary_exercise == 'squat':
                        if vid_total_reps > 0:
                            if vid_faulty_reps > 0:
                                is_overall_correct = False
                                for err in unique_errors:
                                    final_faults.append(err)
                        else:
                            if global_min_knee > 115:
                                is_overall_correct = False
                                final_faults.append(f"Shallow Squat: Maximum depth reached was only {global_min_knee:.0f}° (Target ~90°)")
                            if global_max_torso > 50.0:
                                is_overall_correct = False
                                final_faults.append(f"Excessive Forward Lean: Torso collapsed to {global_max_torso:.0f}° from vertical")

                    elif primary_exercise == 'pushup':
                        if vid_total_reps > 0:
                            if vid_faulty_reps > 0:
                                is_overall_correct = False
                                for err in unique_errors:
                                    final_faults.append(err)
                        else:
                            if global_min_elbow > 110:
                                is_overall_correct = False
                                final_faults.append(f"Incomplete Push-up Depth: Chest lowered only to {global_min_elbow:.0f}° (Target ~90°)")
                            if global_max_hip_dev > 0.06:
                                is_overall_correct = False
                                final_faults.append("Sagging Hips: Core disengaged during movement")

                    elif primary_exercise == 'plank':
                        if plank_sag_count > max(3, total_frames * 0.15):
                            is_overall_correct = False
                            final_faults.append("Sagging Lower Back: Hips dropped below neutral line during hold")

                    elif primary_exercise == 'deadlift':
                        if deadlift_round_count > max(3, total_frames * 0.15):
                            is_overall_correct = False
                            final_faults.append("Rounded Spine / Stiff Leg: Upper/Lower back curving dangerously during pull")

                    # Final Status and Score
                    if is_overall_correct:
                        overall_status = "CORRECT FORM OVERALL ✅"
                        final_score = max(88, int(avg_score))
                        accuracy_rate = 100.0 if vid_total_reps == 0 else round((vid_correct_reps / max(1, vid_total_reps)) * 100, 1)
                        final_risk_msg = "Low Injury Risk (Optimal Joint Biomechanics Maintained Across Reps)"
                    else:
                        overall_status = "INCORRECT FORM (FAULTY) ❌"
                        final_score = min(58, int(avg_score))
                        accuracy_rate = 0.0 if vid_total_reps == 0 else round((vid_correct_reps / max(1, vid_total_reps)) * 100, 1)
                        if primary_exercise == 'squat':
                            final_risk_msg = "⚠️ High Injury Risk: Patellofemoral Knee Strain / Lumbar Shear Stress"
                        elif primary_exercise == 'pushup':
                            final_risk_msg = "⚠️ High Injury Risk: Anterior Shoulder Impingement / Lumbar Hyperextension"
                        elif primary_exercise == 'plank':
                            final_risk_msg = "⚠️ High Injury Risk: Lumbar Spine Disk Strain & Lower Back Fatigue"
                        elif primary_exercise == 'deadlift':
                            final_risk_msg = "⚠️ Critical Injury Risk: Acute Lumbar Disc Herniation (L4-S1)"
                        else:
                            final_risk_msg = "⚠️ Injury Risk: Rotator Cuff Tendonitis / Bicep Tendon Overload"

                    # 🎙️ Voice Coach — Final Video Analysis Summary
                    if is_overall_correct:
                        vid_vc_summary = f"Video analysis complete. Your {primary_exercise} form is correct. Score: {final_score} out of 100. Excellent work!"
                    else:
                        fault_hint = final_faults[0] if final_faults else "posture errors detected"
                        vid_vc_summary = f"Video analysis complete. Faults detected in your {primary_exercise}. Please correct: {fault_hint}. Score: {final_score}."
                    maybe_speak(vid_vc_summary, force=True)

                    # Log video session to SQLite
                    log_workout_session(
                        username=active_user_handle,
                        exercise_name=primary_exercise,
                        total_reps=vid_total_reps,
                        correct_reps=vid_correct_reps,
                        wrong_reps=vid_faulty_reps,
                        form_score=final_score,
                        is_correct=is_overall_correct,
                        feedback=", ".join(final_faults) if final_faults else "Optimal form maintained throughout video"
                    )

                    # Summary Metric Cards
                    r_col1, r_col2, r_col3, r_col4 = st.columns(4)
                    with r_col1:
                        st.markdown(f"""
                        <div class="metric-box">
                            <div class="metric-box-lbl">Detected Exercise</div>
                            <div class="metric-box-val" style="font-size:1.5rem; color:#c084fc;">{primary_exercise.upper()}</div>
                            <div style="color:#34d399; font-size:0.8rem; font-weight:600;">{total_frames} Frames Processed</div>
                        </div>
                        """, unsafe_allow_html=True)

                    with r_col2:
                        st.markdown(f"""
                        <div class="metric-box">
                            <div class="metric-box-lbl">Overall Form Score</div>
                            <div class="metric-box-val" style="color:{'#34d399' if is_overall_correct else '#fb7185'};">{final_score}/100</div>
                            <div style="color:#94a3b8; font-size:0.8rem; font-weight:600;">Kinematic Quality Score</div>
                        </div>
                        """, unsafe_allow_html=True)

                    with r_col3:
                        st.markdown(f"""
                        <div class="metric-box">
                            <div class="metric-box-lbl">Repetition Accuracy</div>
                            <div class="metric-box-val" style="color:{'#34d399' if is_overall_correct else '#fb7185'};">{accuracy_rate}%</div>
                            <div style="color:#38bdf8; font-size:0.8rem; font-weight:600;">{vid_correct_reps} Correct | {vid_faulty_reps} Faulty</div>
                        </div>
                        """, unsafe_allow_html=True)

                    with r_col4:
                        st.markdown(f"""
                        <div class="metric-box">
                            <div class="metric-box-lbl">Clinical Verdict</div>
                            <div class="metric-box-val" style="font-size:1.1rem; color:{'#34d399' if is_overall_correct else '#fb7185'};">{overall_status}</div>
                            <div style="color:#94a3b8; font-size:0.8rem; font-weight:600;">SQLite Database Saved 💾</div>
                        </div>
                        """, unsafe_allow_html=True)

                    st.markdown("<br>", unsafe_allow_html=True)

                    # Diagnostic Report Block
                    st.markdown(f"""
                    <div class="modern-card">
                        <h4 style="color: {'#34d399' if is_overall_correct else '#fb7185'}; margin:0 0 10px 0;">{overall_status}</h4>
                        <div style="font-size: 1.05rem; font-weight: 600; color: #f8fafc; margin-bottom: 8px;">
                            {final_risk_msg}
                        </div>
                        <div style="color: #94a3b8; font-size: 0.95rem;">
                            <b>Total Completed Reps:</b> {vid_total_reps} ({vid_correct_reps} optimal, {vid_faulty_reps} faulty).
                        </div>
                    </div>
                    """, unsafe_allow_html=True)

                    if final_faults:
                        with st.expander("🚨 Detected Biomechanical Faults & Error Breakdown", expanded=True):
                            for idx, fault in enumerate(final_faults, 1):
                                st.error(f"**Fault {idx}:** {fault}")

                    with st.expander("🩺 Physiotherapy & Corrective Prescription Guidelines", expanded=True):
                        for p in (last_rx or ["Maintain upright posture, brace core, and observe controlled tempo."]):
                            st.write(f"• {p}")

                    # PDF & Text Download Buttons
                    p_col1, p_col2 = st.columns(2)
                    with p_col1:
                        pdf_video_bytes = generate_clinical_pdf_report(
                            user_name=st.session_state['user_name'],
                            exercise_name=primary_exercise,
                            is_correct=is_overall_correct,
                            score=final_score,
                            accuracy_rate=accuracy_rate,
                            total_frames=total_frames,
                            joint_angles=last_angles or {'avg_knee': global_min_knee, 'avg_elbow': global_min_elbow, 'torso_inc': global_max_torso, 'symmetry_score': 90},
                            errors=final_faults,
                            injury_risk=final_risk_msg,
                            prescriptions=last_rx or ["Maintain controlled cadence"],
                            file_name=uploaded_file.name
                        )
                        st.download_button(
                            label="📄 Download Official Video Audit Certificate (PDF)",
                            data=pdf_video_bytes,
                            file_name=f"PoseAI_Video_Audit_{primary_exercise}.pdf",
                            mime="application/pdf",
                            use_container_width=True
                        )

                    with p_col2:
                        video_report_text = f"""POSEAI CLINICAL BIOMECHANICAL AUDIT
Patient / User: {st.session_state['user_name']}
Exercise: {primary_exercise.upper()}
Overall Verdict: {overall_status}
Kinematic Form Score: {final_score}/100
Repetition Accuracy: {accuracy_rate}% ({vid_correct_reps} correct, {vid_faulty_reps} faulty)
Injury Risk Assessment: {final_risk_msg}
Detected Faults: {', '.join(final_faults) if final_faults else 'None (Optimal Form)'}
"""
                        st.download_button(
