# =========================================================
# 🎙️ DESKTOP VOICE COACH ENGINE (Python pyttsx3 Native Speech)
# =========================================================

class DesktopVoiceCoach:
    """
    Hardware-native text-to-speech engine running in a dedicated background
    daemon thread. Plays directly through PC speakers without browser iframe
    or autoplay restrictions. Non-blocking and thread-safe.
    """
    def __init__(self):
        self.q = queue.Queue(maxsize=2)
        self.last_spoken_time = 0.0
        self.last_message = ""
        self.lock = threading.Lock()
        self.thread = threading.Thread(target=self._worker, daemon=True)
        self.thread.start()

    def _worker(self):
        engine = None
        if pyttsx3 is not None:
            try:
                if pythoncom is not None:
                    pythoncom.CoInitialize()
                engine = pyttsx3.init()
                engine.setProperty('rate', 160)
                voices = engine.getProperty('voices')
                for v in voices:
                    v_name = v.name.lower()
                    if 'david' in v_name or 'zira' in v_name or 'english' in v_name:
                        engine.setProperty('voice', v.id)
                        break
            except Exception as e:
                engine = None

        while True:
            msg = self.q.get()
            if msg:
                spoken = False
                if engine is not None:
                    try:
                        engine.say(msg)
                        engine.runAndWait()
                        spoken = True
                    except Exception:
                        spoken = False
                if not spoken:
                    try:
                        clean_text = msg.replace("'", " ").replace('"', ' ')
                        cmd = f"Add-Type -AssemblyName System.Speech; (New-Object System.Speech.Synthesis.SpeechSynthesizer).Speak('{clean_text}')"
                        subprocess.run(["powershell", "-NoProfile", "-Command", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    except Exception:
                        pass
            self.q.task_done()

    def speak(self, message: str, interval: float = 6.0, force: bool = False):
        if not message:
            return
        now = time.time()
        with self.lock:
            if not force:
                # Enforce interval cooldown to stop voice looping
                if (now - self.last_spoken_time < interval):
                    return
                if not self.q.empty():
                    return
            else:
                # Emergency / Rep feedback: enforce minimum 3s gap
                if (now - self.last_spoken_time < 3.0):
                    return
                try:
                    while not self.q.empty():
                        self.q.get_nowait()
                        self.q.task_done()
                except Exception:
                    pass
            self.last_spoken_time = now
            self.last_message = message
            try:
                self.q.put_nowait(message)
            except Exception:
                pass


@st.cache_resource
def get_voice_coach():
    return DesktopVoiceCoach()


def speak(message: str, force: bool = False):
    """Speaks message via background native voice engine."""
    coach = get_voice_coach()
    coach.speak(message, force=force)


def get_voice_feedback(
    exercise: str,
    is_correct: bool,
    errors: list,
    score: int,
    rep_count: int = 0,
    stage: str = ""
) -> str:
    """
    Speaks ONLY when posture is incorrect.
    Format: 'Correction: [Actionable fix]. Injury Warning: [Specific orthopedic risk].'
    Completely silent when form is correct (no voice loop).
    """
    # 🔇 SILENT when posture is correct — prevents voice looping
    if is_correct or not errors:
        return ""

    exercise = exercise.lower().replace(" ", "").replace("_", "")
    err = errors[0].lower()

    # 1. Squat Posture Errors
    if "excessive forward lean" in err or "torso" in err:
        return "Correction: Keep your chest upright and drive your hips back. Injury Warning: Forward lean causes acute lumbar shear stress and lower back strain."
    elif "knee hyperflexion" in err or "meniscus" in err:
        return "Correction: Stop descending at 90 degrees parallel. Injury Warning: Deep hyperflexion compresses meniscus cartilage and strains patellar tendons."
    elif "shallow" in err or "depth" in err:
        return "Correction: Descend deeper until thighs reach parallel to the ground. Injury Warning: Shallow squats overload knee joints without engaging the glutes."
    elif "valgus" in err or "knee collapse" in err:
        return "Correction: Push your knees outward in line with your toes. Injury Warning: Inward knee collapse causes severe ACL and medial meniscus tears."

    # 2. Push-up & Plank Posture Errors
    elif "sagging" in err or "hips dropping" in err:
        return "Correction: Squeeze your glutes and tighten your core into a rigid straight line. Injury Warning: Sagging hips causes lumbar hyperextension and spinal disc compression."
    elif "piked" in err:
        return "Correction: Lower your hips to align with your shoulders and heels. Injury Warning: Raised hips shift excessive load into shoulders, causing anterior shoulder impingement."
    elif "incomplete" in err and exercise == "pushup":
        return "Correction: Lower your chest smoothly until elbows reach 90 degrees. Injury Warning: Incomplete depth leads to shoulder anterior ligament strain and muscle imbalance."

    # 3. Deadlift Posture Errors
    elif "rounded spine" in err or "stiff leg" in err:
        return "Correction: Flatten your back, bend your knees, and hinge strictly from your hips. Injury Warning: A rounded spine causes acute lumbar disc herniation at L4 S1."
    elif "hyperextension" in err and exercise == "deadlift":
        return "Correction: Stand tall with a neutral vertical spine and lock out with your glutes. Injury Warning: Leaning backwards crushes your lumbar facet joints."

    # 4. Pull-up Posture Errors
    elif "swing" in err or "momentum" in err:
        return "Correction: Stabilize your core and pull with controlled cadence. Injury Warning: Kipping and swinging causes rotator cuff tears and shoulder labrum damage."
    elif "incomplete" in err and exercise == "pullup":
        return "Correction: Drive your elbows down and pull until your chin clears the bar. Injury Warning: Partial pullups strain bicep tendons."

    # 5. General Spinal / Orthopedic Error
    elif "lumbar" in err or "spine" in err or "back" in err:
        return "Correction: Re-align your spine into a neutral position. Injury Warning: Misalignment causes spinal disc fatigue and chronic lower back pain."
    else:
        fault_name = errors[0].split(':')[0]
        return f"Correction: Re-align your joints to fix {fault_name}. Injury Warning: Flawed biomechanics causes orthopedic joint strain."


# ──────────────────────────────────────────────────────────────
# Voice Coach UI Settings (Sidebar helper)
# ──────────────────────────────────────────────────────────────
def voice_coach_sidebar() -> dict:
    """Renders voice coach settings in the sidebar, returns config dict."""
    st.sidebar.markdown("---")
    st.sidebar.markdown("### 🎙️ AI Voice Coach (English)")
    vc_enabled = st.sidebar.toggle("Enable Voice Coach", value=True)
    vc_interval = st.sidebar.slider("Voice Alert Interval (seconds)", 4, 15, 6,
                                    help="Minimum gap between consecutive voice alerts to prevent looping")
    
    # 🔊 Quick test button directly in sidebar!
    if st.sidebar.button("🔊 Test Voice Coach Now", use_container_width=True):
        coach = get_voice_coach()
        coach.speak("Voice coach is active. I will alert you whenever posture is incorrect with corrections and injury warnings.", force=True)
        st.sidebar.success("🔊 Speaking through PC speakers!")

    return {"enabled": vc_enabled, "interval": vc_interval}


# =========================================================
# PDF CLINICAL REPORT GENERATOR (REPORTLAB)
# =========================================================
def generate_clinical_pdf_report(user_name, exercise_name, is_correct, score, accuracy_rate, total_frames, 
                                 joint_angles, errors, injury_risk, prescriptions, file_name="Live_Stream"):
    """
    Generates an executive, hospital/sports-clinic grade PDF Audit Certificate.
    """
    buf = io.BytesIO()
    doc = SimpleDocTemplate(
        buf,
        pagesize=letter,
        rightMargin=36,
        leftMargin=36,
        topMargin=36,
        bottomMargin=36
    )
    
    styles = getSampleStyleSheet()
    
    c_primary = colors.HexColor("#1e1b4b")   # Dark Navy Indigo
    c_accent = colors.HexColor("#0284c7")    # Sky Blue
    c_success = colors.HexColor("#16a34a")   # Green
    c_danger = colors.HexColor("#dc2626")    # Red
    c_dark = colors.HexColor("#1e293b")      # Slate Dark
    c_bg = colors.HexColor("#f8fafc")        # Soft Slate Light
    
    title_style = ParagraphStyle(
        'DocTitle',
        parent=styles['Heading1'],
        fontName='Helvetica-Bold',
        fontSize=20,
        leading=24,
        textColor=c_primary,
        alignment=1
    )
    
    subtitle_style = ParagraphStyle(
        'DocSubTitle',
        parent=styles['Normal'],
        fontName='Helvetica',
        fontSize=10,
        leading=13,
        textColor=c_accent,
        alignment=1
    )
    
    sec_title = ParagraphStyle(
        'SectionHeading',
        parent=styles['Heading2'],
        fontName='Helvetica-Bold',
        fontSize=12,
        leading=16,
        textColor=c_primary,
        spaceAfter=6
    )
    
    body_style = ParagraphStyle(
        'BodyTextCustom',
        parent=styles['Normal'],
        fontName='Helvetica',
        fontSize=9,
        leading=13,
        textColor=c_dark
    )
    
    elements = []
    
    # Header
    elements.append(Paragraph("AI BIOMECHANICAL AUDIT & CLINICAL CERTIFICATE", title_style))
    elements.append(Paragraph("PoseAI Center for Biomechanical Intelligence & Orthopedic Prevention", subtitle_style))
    elements.append(Spacer(1, 10))
    elements.append(HRFlowable(width="100%", thickness=2, color=c_accent, spaceBefore=4, spaceAfter=14))
    
    # Metadata Table
    status_label = "CLINICALLY OPTIMAL FORM [PASS]" if is_correct else "BIOMECHANICAL FAULT DETECTED [NEEDS CORRECTION]"
    status_color = c_success if is_correct else c_danger
    
    meta_data = [
        [
            Paragraph(f"<b>Patient / Athlete:</b> {user_name}", body_style),
            Paragraph(f"<b>Audit Date:</b> {time.strftime('%Y-%m-%d %H:%M:%S')}", body_style)
        ],
        [
            Paragraph(f"<b>Evaluated Exercise:</b> {exercise_name.upper()}", body_style),
            Paragraph(f"<b>Total Analyzed Frames:</b> {total_frames}", body_style)
        ],
        [
            Paragraph(f"<b>Kinematic Quality Score:</b> {score} / 100", body_style),
            Paragraph(f"<b>Repetition Accuracy:</b> {accuracy_rate}%", body_style)
        ],
        [
            Paragraph(f"<b>Clinical Verdict:</b> <font color='{status_color.hexval()}'><b>{status_label}</b></font>", body_style),
            Paragraph(f"<b>Source Media:</b> {file_name}", body_style)
        ]
    ]
    meta_table = Table(meta_data, colWidths=[270, 270])
    meta_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), c_bg),
        ('BOX', (0,0), (-1,-1), 1, colors.HexColor("#cbd5e1")),
        ('INNERGRID', (0,0), (-1,-1), 0.5, colors.HexColor("#e2e8f0")),
        ('PADDING', (0,0), (-1,-1), 6),
    ]))
    elements.append(meta_table)
    elements.append(Spacer(1, 14))
    
    # Joint Angle Table
    elements.append(Paragraph("1. Precision Bilateral Kinematic Measurements", sec_title))
    angle_rows = [
        ["Joint Landmark", "Measured Angle / Value", "Physiological Target Reference", "Biomechanical Evaluation"]
    ]
    
    knee_ang = joint_angles.get('avg_knee', 0)
    elbow_ang = joint_angles.get('avg_elbow', 0)
    hip_ang = joint_angles.get('avg_hip', 0)
    torso_inc = joint_angles.get('torso_inc', 0)
    sym_score = joint_angles.get('symmetry_score', 0)
    
    angle_rows.append(["Knee Joint Flexion", f"{knee_ang:.1f}°", "Parallel Depth ~ 70°-100°", "Optimal" if 65 <= knee_ang <= 105 or knee_ang > 145 else "Check Depth"])
    angle_rows.append(["Elbow Joint Flexion", f"{elbow_ang:.1f}°", "Lockout 160° / Pushup Chest 90°", "Safe ROM" if elbow_ang <= 105 or elbow_ang >= 150 else "Partial ROM"])
    angle_rows.append(["Hip / Back Joint Flexion", f"{hip_ang:.1f}°", "Squat Hinge 70°-100° / Plank 160°-180°", "Stable Neutral" if hip_ang >= 65 else "Extreme Flexion"])
    angle_rows.append(["Torso Inclination from Vertical", f"{torso_inc:.1f}°", "Upright: 0°-40° / Max: < 48°", "Optimal" if torso_inc <= 48 else "Excessive Lean"])
    angle_rows.append(["Bilateral Symmetry Score", f"{sym_score:.1f}%", "Target Symmetrical > 85.0%", "Balanced" if sym_score >= 85 else "Asymmetric"])
    
    angle_table = Table(angle_rows, colWidths=[150, 110, 150, 130])
    angle_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), c_primary),
        ('TEXTCOLOR', (0,0), (-1,0), colors.white),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
        ('FONTSIZE', (0,0), (-1,0), 8),
        ('BOTTOMPADDING', (0,0), (-1,0), 5),
        ('BACKGROUND', (0,1), (-1,-1), colors.white),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor("#cbd5e1")),
        ('FONTNAME', (0,1), (-1,-1), 'Helvetica'),
        ('FONTSIZE', (0,1), (-1,-1), 8),
        ('PADDING', (0,0), (-1,-1), 5),
    ]))
    elements.append(angle_table)
    elements.append(Spacer(1, 14))
    
    # Injury Risk Section
    elements.append(Paragraph("2. Orthopedic & Kinetic Injury Risk Assessment", sec_title))
    risk_text = f"<b>Risk Classification:</b> {injury_risk}"
    elements.append(Paragraph(risk_text, body_style))
    if errors:
        elements.append(Spacer(1, 4))
        for err in errors:
            elements.append(Paragraph(f"• <font color='red'><b>Biomechanical Flaw:</b></font> {err}", body_style))
    elements.append(Spacer(1, 14))
    
    # Corrective Prescriptions
    elements.append(Paragraph("3. Physiotherapy & Corrective Exercise Prescription", sec_title))
    if prescriptions:
        for rx in prescriptions:
            elements.append(Paragraph(f"• {rx}", body_style))
    else:
        elements.append(Paragraph("• Continue regular training progression with progressive overload and controlled cadence.", body_style))
    elements.append(Spacer(1, 16))
    
    # Sign-off block
    elements.append(HRFlowable(width="100%", thickness=1, color=colors.HexColor("#cbd5e1"), spaceBefore=4, spaceAfter=8))
    sign_data = [
        [Paragraph("<b>Certified By:</b> PoseAI Automated Biomechanics Diagnostic Suite", body_style),
         Paragraph("<b>Clinical Verification:</b> 100% Certified Algorithmic Model", body_style)]
    ]
    sign_table = Table(sign_data, colWidths=[270, 270])
    elements.append(sign_table)

    doc.build(elements)
    buf.seek(0)
    return buf.getvalue()


# =========================================================
# PRECISION BIOMECHANICAL POSTURE & INJURY RISK ENGINE
# =========================================================
def evaluate_advanced_posture(landmarks_list, exercise_name):
    """
    Precision multi-joint biomechanical evaluation.
    Utilizes 2D planar projection to eliminate monocular depth noise.
    Accurately detects Parallel Squats, Controlled Torso Lean, Sagging vs Piked Hips, and Deadlift Hinges.
    """
    exercise_name = str(exercise_name).lower().replace(" ", "").replace("_", "")
    
    def get_vis(idx):
        if len(landmarks_list[idx]) > 3:
            return float(landmarks_list[idx][3])
        return 1.0

    # Bilateral visibility check
    left_vis = (get_vis(11) + get_vis(13) + get_vis(23) + get_vis(25) + get_vis(27)) / 5.0
    right_vis = (get_vis(12) + get_vis(14) + get_vis(24) + get_vis(26) + get_vis(28)) / 5.0
    
    # Bilateral 2D planar joint angles
    l_knee = calculate_angle_2d(landmarks_list[23], landmarks_list[25], landmarks_list[27])
    r_knee = calculate_angle_2d(landmarks_list[24], landmarks_list[26], landmarks_list[28])
    
    l_elbow = calculate_angle_2d(landmarks_list[11], landmarks_list[13], landmarks_list[15])
    r_elbow = calculate_angle_2d(landmarks_list[12], landmarks_list[14], landmarks_list[16])
    
    l_hip = calculate_angle_2d(landmarks_list[11], landmarks_list[23], landmarks_list[25])
    r_hip = calculate_angle_2d(landmarks_list[12], landmarks_list[24], landmarks_list[26])
    
    l_bodyline = calculate_angle_2d(landmarks_list[11], landmarks_list[23], landmarks_list[27])
    r_bodyline = calculate_angle_2d(landmarks_list[12], landmarks_list[24], landmarks_list[28])
    
    l_torso_inc = calculate_torso_inclination(landmarks_list[11], landmarks_list[23])
    r_torso_inc = calculate_torso_inclination(landmarks_list[12], landmarks_list[24])
    
    l_hip_dev = calculate_hip_deviation_2d(landmarks_list[11], landmarks_list[23], landmarks_list[27])
    r_hip_dev = calculate_hip_deviation_2d(landmarks_list[12], landmarks_list[24], landmarks_list[28])
    
    # Robust dominant side selection (handles side-profile vs front profile views)
    if abs(left_vis - right_vis) > 0.22:
        if left_vis > right_vis:
            knee, elbow, hip, bodyline, torso_inc, hip_dev = l_knee, l_elbow, l_hip, l_bodyline, l_torso_inc, l_hip_dev
        else:
            knee, elbow, hip, bodyline, torso_inc, hip_dev = r_knee, r_elbow, r_hip, r_bodyline, r_torso_inc, r_hip_dev
    else:
        knee = (l_knee + r_knee) / 2.0
        elbow = (l_elbow + r_elbow) / 2.0
        hip = (l_hip + r_hip) / 2.0
        bodyline = (l_bodyline + r_bodyline) / 2.0
        torso_inc = (l_torso_inc + r_torso_inc) / 2.0
        hip_dev = (l_hip_dev + r_hip_dev) / 2.0

    # Left-Right Symmetry Index
    knee_sym = max(0, 100 - abs(l_knee - r_knee))
    elbow_sym = max(0, 100 - abs(l_elbow - r_elbow))
    hip_sym = max(0, 100 - abs(l_hip - r_hip))
    overall_symmetry = round((knee_sym + elbow_sym + hip_sym) / 3.0, 1)

    joint_angles = {
        'left_knee': round(l_knee, 1),
        'right_knee': round(r_knee, 1),
        'avg_knee': round(knee, 1),
        'left_elbow': round(l_elbow, 1),
        'right_elbow': round(r_elbow, 1),
        'avg_elbow': round(elbow, 1),
        'left_back': round(l_hip, 1),
        'right_back': round(r_hip, 1),
        'avg_back': round(hip, 1),
        'avg_hip': round(hip, 1),
        'bodyline': round(bodyline, 1),
        'torso_inc': round(torso_inc, 1),
        'hip_dev': round(hip_dev, 3),
        'knee_sym': round(knee_sym, 1),
        'elbow_sym': round(elbow_sym, 1),
        'back_sym': round(hip_sym, 1),
        'hip_sym': round(hip_sym, 1),
        'symmetry_score': overall_symmetry
    }

    errors = []
    faulty_joints = []
    prescriptions = []
    score = 100

    # 1. SQUAT POSTURE EVALUATION
    if exercise_name == 'squat':
        # Standing / Top Phase
        if knee > 145:
            status = "Correct Form ✅ (Standing / Preparation Phase)"
            risk = "Low Injury Risk (Optimal Knee & Spinal Alignment)"
            prescriptions.append("🌟 Form is optimal! Maintain upright chest and braced abdominal core.")
            
        # Parallel / Deep Squat Phase (Knee <= 105°)
        elif knee <= 105:
            if torso_inc > 48.0:
                errors.append(f"Excessive Forward Lean: Torso inclined {torso_inc:.0f}° from vertical (Spinal shear stress)")
                faulty_joints.extend([11, 12, 23, 24])
                prescriptions.append("🏋️ Keep chest upright & engage core; strengthen thoracic spine with Goblet Squats")
                score -= 35
                
            if knee < 48.0:
                errors.append(f"Excessive Knee Hyperflexion ({knee:.0f}° < 50°): Excessive meniscus compression")
                faulty_joints.extend([25, 26])
                prescriptions.append("⚠️ Limit descent to parallel (90°) to protect meniscus cartilages")
                score -= 25
                
            if len(errors) == 0:
                status = f"Correct Form ✅ (Optimal Parallel Depth: {knee:.0f}°)"
                risk = "Low Injury Risk (Optimal Knee & Spinal Alignment)"
                prescriptions.append("🌟 Optimal parallel squat depth with safe spinal angle! Drive through mid-foot.")
            else:
                status = f"Incorrect Form ❌ ({errors[0]})"
                risk = "⚠️ Injury Risk: Patellofemoral Knee Strain / Lumbar Shear Stress"
                
        # Descent / Ascent Transition Phase (105° < knee <= 145°)
        else:
            if torso_inc > 48.0:
                errors.append(f"Excessive Forward Lean: Torso collapsing forward ({torso_inc:.0f}°)")
                faulty_joints.extend([11, 12, 23, 24])
                score -= 35
                
            if len(errors) == 0:
                status = f"Correct Form ✅ (Controlled Squat Motion: {knee:.0f}°)"
                risk = "Low Injury Risk (Controlled Biomechanics)"
                prescriptions.append("🎯 Continue controlled descent until thighs reach parallel ~90°")
            else:
                status = f"Incorrect Form ❌ ({errors[0]})"
                risk = "⚠️ Injury Risk: Lumbar Flexion Shear Stress"

    # 2. PUSH-UP POSTURE EVALUATION
    elif exercise_name == 'pushup':
        # Body Line & Core Alignment Check
        if hip_dev > 0.055:
            errors.append("Sagging Hips: Core disengaged (Hips dropping towards floor)")
            faulty_joints.extend([23, 24])
            prescriptions.append("🔥 Strengthen Transverse Abdominis with Deadbug & Plank holds; squeeze glutes")
            score -= 40
        elif hip_dev < -0.075:
            errors.append("Piked Hips: Hips raised excessively high above body line")
            faulty_joints.extend([23, 24])
            prescriptions.append("📏 Align shoulders, hips, and heels into a single rigid neutral plane")
            score -= 30

        if len(errors) == 0:
            if elbow <= 100:
                status = f"Correct Form ✅ (Optimal Chest Depth: {elbow:.0f}°)"
                risk = "Low Injury Risk (Safe Shoulder & Core Alignment)"
                prescriptions.append("🌟 Full chest depth achieved with rigid core stabilization!")
            else:
                status = f"Correct Form ✅ (Plank / Lockout Phase: {elbow:.0f}°)"
                risk = "Low Injury Risk (Neutral Glenohumeral Dynamics)"
                prescriptions.append("🎯 Lower chest smoothly until elbows reach 90° flexion")
        else:
            status = f"Incorrect Form ❌ ({errors[0]})"
            risk = "⚠️ Injury Risk: Anterior Shoulder Impingement / Lumbar Hyperextension"

    # 3. PLANK POSTURE EVALUATION
    elif exercise_name == 'plank':
        if hip_dev > 0.050:
            errors.append("Sagging Lower Back: Hips dropped below neutral line")
            faulty_joints.extend([23, 24])
            prescriptions.append("🛡️ Squeeze glutes & brace abdominal wall; avoid arching lumbar spine")
            score -= 40
        elif hip_dev < -0.070:
            errors.append("Piked Plank: Hips raised too high above neutral line")
            faulty_joints.extend([23, 24])
            prescriptions.append("📐 Lower pelvis slightly until torso forms a flat horizontal plane")
            score -= 30

        if len(errors) == 0:
            status = "Correct Form ✅ (Neutral Isometric Spine Line)"
            risk = "Low Injury Risk (Neutral Isometric Core Stability)"
            prescriptions.append("🌟 Solid isometric core engagement and neutral lumbar spine")
        else:
            status = f"Incorrect Form ❌ ({errors[0]})"
            risk = "⚠️ Injury Risk: Lumbar Spine Disk Strain & Lower Back Fatigue"

    # 4. DEADLIFT POSTURE EVALUATION
    elif exercise_name == 'deadlift':
        # Top Lockout Phase
        if knee > 155 and hip > 155:
            if torso_inc > 22.0:
                errors.append("Lumbar Hyperextension: Excessive leaning backward at lockout")
                faulty_joints.extend([11, 12, 23, 24])
                score -= 30
            if len(errors) == 0:
                status = "Correct Form ✅ (Solid Lockout Phase)"
                risk = "Low Injury Risk (Neutral Spinal Lordosis)"
                prescriptions.append("🌟 Strong lockout with neutral spine and engaged glutes")
            else:
                status = f"Incorrect Form ❌ ({errors[0]})"
                risk = "⚠️ Injury Risk: Lumbar Facet Joint Compression"
        # Pull / Hip Hinge Phase
        else:
            if torso_inc > 65.0 and knee > 145.0:
                errors.append("Rounded Spine / Stiff Leg: Back bending forward without knee flexion")
                faulty_joints.extend([11, 12, 23, 24])
                prescriptions.append("🚨 Bend knees and push hips back; keep bar close to shins")
                score -= 45
            if len(errors) == 0:
                status = "Correct Form ✅ (Solid Posterior Chain Hip Hinge)"
                risk = "Low Injury Risk (Safe Hinge Dynamics)"
                prescriptions.append("🌟 Perfect hip hinge mechanics with neutral lumbar lordosis")
            else:
                status = f"Incorrect Form ❌ ({errors[0]})"
                risk = "⚠️ Critical Injury Risk: Acute Lumbar Disc Herniation (L4-S1)"

    # 5. PULL-UP POSTURE EVALUATION
    elif exercise_name == 'pullup':
        if elbow <= 85:
            status = f"Correct Form ✅ (Peak Chin-Over-Bar Depth: {elbow:.0f}°)"
            risk = "Low Injury Risk (Full Latissimus Activation)"
            prescriptions.append("🌟 Full active range of motion with excellent scapular retraction")
        elif elbow >= 150:
            status = "Correct Form ✅ (Full Extension / Dead-hang Phase)"
            risk = "Low Injury Risk (Full Latissimus Activation)"
            prescriptions.append("🌟 Full dead-hang stretch achieved; engage lats to initiate pull")
        else:
            status = f"Correct Form ✅ (Controlled Pull Motion: {elbow:.0f}°)"
            risk = "Low Injury Risk (Controlled Bicep & Lat Dynamics)"
            prescriptions.append("🎯 Pull smoothly until chin clears the bar")

    else:
        status = "Analyzing Motion..."
        risk = "Calculating..."
        score = 85
        prescriptions.append("Align full body inside camera frame")

    score = max(10, min(100, score))
    return status, risk, score, errors, joint_angles, faulty_joints, prescriptions


# Backward-compatible wrapper
def check_posture_and_risk(landmarks_list, exercise_name):
    status, risk, score, errors, angles, faulty, rx = evaluate_advanced_posture(landmarks_list, exercise_name)
    return status, risk


# =========================================================
# OPENCV COLOR-CODED SKELETON & ANGLE HUD RENDERER
# =========================================================
def draw_biomechanical_hud(frame, landmarks_list, exercise_name, is_correct, score, joint_angles, faulty_joints, rep_stats=None):
    """
    Renders professional color-coded biomechanical joints and HUD onto the frame.
    Green = Optimal Form, Red = Biomechanical Error.
    """
    h, w, _ = frame.shape
    main_color = (0, 230, 115) if is_correct else (0, 50, 255) # Green vs Red (BGR)
    
    connections = [
        (11, 13), (13, 15), # Left Arm
        (12, 14), (14, 16), # Right Arm
        (11, 12),           # Shoulders
        (11, 23), (12, 24), # Torso
        (23, 24),           # Hips
        (23, 25), (25, 27), # Left Leg
        (24, 26), (26, 28)  # Right Leg
    ]
    
    for (start_idx, end_idx) in connections:
        pt1 = (int(landmarks_list[start_idx][0] * w), int(landmarks_list[start_idx][1] * h))
        pt2 = (int(landmarks_list[end_idx][0] * w), int(landmarks_list[end_idx][1] * h))
        
        if start_idx in faulty_joints or end_idx in faulty_joints:
            line_col = (0, 0, 255) # Red
            thickness = 4
        else:
            line_col = (0, 255, 120) if is_correct else (0, 200, 255)
            thickness = 3
            
        cv2.line(frame, pt1, pt2, line_col, thickness)

    for idx, lm in enumerate(landmarks_list):
        cx, cy = int(lm[0] * w), int(lm[1] * h)
        if idx in faulty_joints:
            cv2.circle(frame, (cx, cy), 9, (0, 0, 255), -1)
            cv2.circle(frame, (cx, cy), 13, (255, 255, 255), 2)
        else:
            cv2.circle(frame, (cx, cy), 5, (0, 255, 0), -1)

    # Top HUD Status Bar
    overlay = frame.copy()
    cv2.rectangle(overlay, (8, 8), (w - 8, 85), (11, 15, 25), -1)
    cv2.addWeighted(overlay, 0.75, frame, 0.25, 0, frame)
    cv2.rectangle(frame, (8, 8), (w - 8, 85), main_color, 2)

    cv2.putText(frame, f"AI: {exercise_name.upper()}", (20, 36), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    status_text = "FORM: OPTIMAL [OK]" if is_correct else "FORM: FAULTY [CORRECTION NEEDED]"
    cv2.putText(frame, status_text, (20, 68), cv2.FONT_HERSHEY_SIMPLEX, 0.62, main_color, 2)
    
    score_text = f"SCORE: {score}/100"
    cv2.putText(frame, score_text, (w - 200, 36), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (56, 189, 248), 2)
    
    if rep_stats:
        rep_text = f"Reps: {rep_stats['total']} | OK: {rep_stats['correct']} | Bad: {rep_stats['wrong']}"
        cv2.putText(frame, rep_text, (w - 280, 68), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (200, 200, 200), 2)

    return frame


# =========================================================
# PLOTLY BIOMECHANICAL VISUALIZATIONS
# =========================================================
def create_biomechanical_radar_chart(joint_angles, score):
    """Generates an aesthetic Radar Chart showing multi-joint kinematic angles."""
    categories = ['Knee Flexion', 'Elbow Flexion', 'Hip Hinge', 'Symmetry Score', 'Form Quality']
    
    knee_val = min(100, (joint_angles.get('avg_knee', 90) / 180.0) * 100)
    elbow_val = min(100, (joint_angles.get('avg_elbow', 90) / 180.0) * 100)
    hip_val = min(100, (joint_angles.get('avg_hip', 90) / 180.0) * 100)
    sym_val = joint_angles.get('symmetry_score', 85)
    quality_val = score
    
    values = [knee_val, elbow_val, hip_val, sym_val, quality_val]
    values.append(values[0])
    categories_closed = categories + [categories[0]]
    
    fig = go.Figure()
    fig.add_trace(go.Scatterpolar(
        r=values,
        theta=categories_closed,
        fill='toself',
        fillcolor='rgba(6, 182, 212, 0.25)',
        line=dict(color='#06b6d4', width=2.5),
        name='Biomechanical Profile'
    ))
    
    fig.update_layout(
        polar=dict(
            radialaxis=dict(
                visible=True,
                range=[0, 100],
                showticklabels=False,
                linecolor="rgba(255, 255, 255, 0.15)",
                gridcolor="rgba(255, 255, 255, 0.1)"
            ),
            angularaxis=dict(
                tickfont=dict(size=10, color="#94a3b8"),
                linecolor="rgba(255, 255, 255, 0.15)",
                gridcolor="rgba(255, 255, 255, 0.1)"
            ),
            bgcolor="rgba(11, 15, 25, 0.65)"
        ),
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(0,0,0,0)",
        margin=dict(l=35, r=35, t=25, b=25),
        height=260,
        showlegend=False
    )
    return fig


def create_xai_feature_importance_chart(feats_dict):
    """Generates an Explainable AI (XAI) bar chart highlighting key kinematic drivers."""
    key_drivers = {
        'Knee Left': feats_dict.get('knee_angle_left', 0),
        'Knee Right': feats_dict.get('knee_angle_right', 0),
        'Elbow Left': feats_dict.get('elbow_angle_left', 0),
        'Elbow Right': feats_dict.get('elbow_angle_right', 0),
        'Hip Left': feats_dict.get('hip_angle_left', 0),
        'Hip Right': feats_dict.get('hip_angle_right', 0),
        'Ankle Spread': feats_dict.get('ankle_dist_ratio', 0) * 100,
        'Wrist Spread': feats_dict.get('wrist_dist_ratio', 0) * 100
    }
    
    names = list(key_drivers.keys())
    values = [round(v, 1) for v in key_drivers.values()]
    
    fig = px.bar(
        x=values,
        y=names,
        orientation='h',
        labels={'x': 'Kinematic Value (° / Ratio)', 'y': 'Feature'},
        color=values,
        color_continuous_scale="Purples"
    )
    fig.update_layout(
        title="Biomechanical Drivers (XAI Feature Analysis)",
        title_font=dict(size=12, color="#38bdf8"),
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(11, 15, 25, 0.6)",
        font=dict(color="#94a3b8", size=9),
        margin=dict(l=10, r=10, t=30, b=10),
        height=240,
        coloraxis_showscale=False
    )
    return fig


# =========================================================
# LOAD MACHINE LEARNING PIPELINE
# =========================================================
@st.cache_resource
def load_ml_pipeline():
    if os.path.exists('fitness_pipeline_v2.pkl'):
        pipeline = joblib.load('fitness_pipeline_v2.pkl')
        return pipeline
    else:
        model = joblib.load('fitness_model.pkl')
        return {'model': model, 'scaler': None, 'feature_names': None, 'metrics': None}

pipeline_data = load_ml_pipeline()
model = pipeline_data['model']
scaler = pipeline_data.get('scaler')
feature_names = pipeline_data.get('feature_names')
metrics = pipeline_data.get('metrics')

mp_pose = None
pose = None
mp_drawing = None

if mp is not None:
    mp_pose = mp.solutions.pose
    pose = mp_pose.Pose(static_image_mode=False, min_detection_confidence=0.5)
    mp_drawing = mp.solutions.drawing_utils


def pose_runtime_ready():
    return cv2 is not None and mp is not None and pose is not None and mp_drawing is not None


def run_ml_inference(landmarks_list):
    """Executes full feature engineering + model prediction + probability confidence."""
    clean_lms = [lm[:3] for lm in landmarks_list]
    if scaler is not None and feature_names is not None:
        feats_dict = extract_features_from_landmarks(clean_lms)
        feats_df = pd.DataFrame([feats_dict])[feature_names]
        X_scaled = scaler.transform(feats_df)
        pred = model.predict(X_scaled)[0]
        probs = model.predict_proba(X_scaled)[0]
        confidence = float(np.max(probs) * 100.0)
        prob_dict = {cls: round(float(prob * 100.0), 1) for cls, prob in zip(model.classes_, probs)}
        return pred, confidence, prob_dict, feats_dict
    else:
        flat = np.array(clean_lms).flatten().reshape(1, -1)
        pred = model.predict(flat)[0]
        return pred, 99.0, {pred: 99.0}, {}


